@page "/merchants"
@attribute [Authorize(Policy = AdminPolicies.Administrator)]

@using MUnique.OpenMU.Web.AdminPanel.Properties
@using Microsoft.AspNetCore.Components.QuickGrid;
@using MUnique.OpenMU.Interfaces
@using MUnique.OpenMU.Persistence

<PageTitle>OpenMU: @Resources.Merchants</PageTitle>
<Breadcrumb IsFirstFromRoot="true" Caption=@Resources.Merchants/>

<h3 class="admin-page-heading">@Resources.Merchants</h3>


@if (this.ViewModels is null)
{
    return;
}

@if (this._selectedMerchant is null)
{
    <div class="admin-table-page">
        <QuickGrid Items="@this.ViewModels" Pagination="@_merchantPagination" Theme="none">
            <PropertyColumn Title="@Resources.ConfigurationEntryName" Property="@(c => c.Name)" Sortable="true">
            </PropertyColumn>

            <TemplateColumn Title="@Resources.Actions" Align="Align.End">
                <div class="admin-table-actions">
                    <button type="button" class="btn admin-table-action admin-table-action--primary" @onclick="@(() => this.OnMerchantEditClickAsync(context))"><span class="oi oi-pencil" aria-hidden="true"></span> @Resources.Edit</button>
                </div>
            </TemplateColumn>
        </QuickGrid>
        <LocalizedPaginator State="@_merchantPagination"/>
    </div>
}
else
{
    <div class="d-flex flex-row">
        <button type="button" class="btn btn-secondary me-3" @onclick="this.OnBackButtonClickAsync">&lt; @Resources.Back</button>
        <h3 class="mb-0">@this._selectedMerchant.Merchant.Designation.ToString()</h3>
    </div>
    <hr/>
    <CascadingValue TValue="IContext" Value="this._persistenceContext">
        <EditForm Model="this._selectedMerchant.Merchant" OnValidSubmit="this.OnSaveButtonClickAsync">
            <div class="mb-2">
                <ExportImport ExportText="@Resources.ExportShop"
                              ImportText="@Resources.ImportShop"
                              ExportFileName="@($"merchant-{this._selectedMerchant.Merchant.Number}-shop.json")"
                              ExportContentProvider="@this.BuildShopExport"
                              OnImport="@this.ImportShopAsync" />
            </div>
            <ItemStorageField @key="this._shopEditorRevision" @bind-Value="this._selectedMerchant.Merchant.MerchantStore" HideLabel="true"/>
            <hr />
            <button type="submit" class="btn btn-primary me-1">@Resources.SaveChanges</button>
            <button type="button" class="btn btn-secondary" @onclick="this.OnCancelButtonClickAsync">@Resources.DiscardChanges</button>
        </EditForm>
    </CascadingValue>
}
