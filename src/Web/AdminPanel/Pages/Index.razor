@page "/"

@using MUnique.OpenMU.DataModel
@using MUnique.OpenMU.Interfaces
@using MUnique.OpenMU.Web.AdminPanel.Components.Dashboard
@using MUnique.OpenMU.Web.AdminPanel.Properties
@using MUnique.OpenMU.Web.AdminPanel.Services

<PageTitle>@Resources.OpenMUAdminPanel</PageTitle>
<Breadcrumb IsFirstFromRoot="true" Caption="@Resources.Home"/>
<header class="dashboard-heading">
    <div>
        <h1>@Resources.Dashboard</h1>
        <p class="dashboard-heading__subtitle">@Resources.WelcomeMessage</p>
    </div>
    <a class="btn btn-outline-secondary dashboard-heading__action" href="servers">
        <span class="oi oi-project" aria-hidden="true"></span>
        @Resources.DashboardManageServers
    </a>
</header>

<div class="dashboard">
    @{
        var coreServers = this._servers.Where(s => s.Type is ServerType.GameServer or ServerType.ConnectServer).ToList();
        var unavailableCoreServers = coreServers.Count(s => s.ServerState != ServerState.Started);
        var gameServers = this._servers.Where(s => s.Type == ServerType.GameServer).ToList();
    }
    <div class="dashboard-health @(coreServers.Count == 0 || unavailableCoreServers > 0 ? "dashboard-health--attention" : "dashboard-health--ok")" role="status">
        <span class="dashboard-health__dot" aria-hidden="true"></span>
        @if (coreServers.Count == 0)
        {
            @Resources.ResourceManager.GetString("DashboardNoCoreServices", Resources.Culture)
        }
        else if (unavailableCoreServers > 0)
        {
            @string.Format(Resources.ResourceManager.GetString("DashboardCoreServicesNeedAttention", Resources.Culture) ?? string.Empty, unavailableCoreServers)
        }
        else
        {
            @Resources.ResourceManager.GetString("DashboardCoreServicesHealthy", Resources.Culture)
        }
        <a href="servers">@Resources.DashboardManageServers</a>
    </div>
    <BotStuckAlarmBanner Line="@this._stuckBotsAlarm" />

    <div class="dashboard-statistics">
        <StatisticCard Title="@Resources.DashboardPlayersOnline" Icon="oi-people">
            <Value>@ServerStatistics.GetOnlinePlayerCount(this._servers).ToString("N0")</Value>
            <ChildContent>
                @Resources.ResourceManager.GetString("DashboardOnlineCountScope", Resources.Culture)
                @if (ServerStatistics.GetPlayerCapacity(this._servers) is { } capacity)
                {
                    <div>@string.Format(Resources.DashboardPlayerCapacity, capacity.ToString("N0"))</div>
                }
            </ChildContent>
        </StatisticCard>
        <StatisticCard Title="@(Resources.ResourceManager.GetString("DashboardGameServers", Resources.Culture) ?? string.Empty)" Icon="oi-project">
            <Value>
                @gameServers.Count(s => s.ServerState == ServerState.Started)
                <span class="stat-denominator">/ @gameServers.Count</span>
            </Value>
            <ChildContent>
                @if (gameServers.Count == 0)
                {
                    @Resources.ResourceManager.GetString("DashboardNoGameServers", Resources.Culture)
                }
                else if (gameServers.Count(s => s.ServerState != ServerState.Started) is var notRunning and > 0)
                {
                    <span class="text-warning-emphasis">@string.Format(Resources.DashboardServersNotRunning, notRunning)</span>
                }
                else
                {
                    @Resources.ResourceManager.GetString("DashboardAllGameServersRunning", Resources.Culture)
                }
            </ChildContent>
        </StatisticCard>
        @if (this._isBotFeatureAvailable)
        {
            <StatisticCard Title="@Resources.BotPlayers" Icon="oi-person">
                <Value>@this.GetStatisticText(this._botCount)</Value>
                <ChildContent>
                    <a href="logged-in?tab=bots">@Resources.ResourceManager.GetString("DashboardBotSnapshot", Resources.Culture)</a>
                </ChildContent>
            </StatisticCard>
        }
        <StatisticCard Title="@Resources.Accounts" Icon="oi-person">
            <Value>@this.GetStatisticText(this._accountStatistics?.AccountCount)</Value>
            <ChildContent>
                @if (this._accountStatistics is { } accounts)
                {
                    <span>@string.Format(Resources.DashboardNewAccounts, accounts.NewAccountCount.ToString("N0"))</span>
                    <span> · @string.Format(Resources.DashboardBannedAccounts, accounts.BannedAccountCount.ToString("N0"))</span>
                }
            </ChildContent>
        </StatisticCard>
        <StatisticCard Title="@Resources.Guilds" Icon="oi-flag">
            <Value>@this.GetStatisticText(this._guildStatistics?.GuildCount)</Value>
            <ChildContent>@this.GetGuildDetails()</ChildContent>
        </StatisticCard>
    </div>

    <div class="dashboard-snapshot">
        <span>
            @if (this._isLoadingStatistics)
            {
                @Resources.ResourceManager.GetString("DashboardSnapshotLoading", Resources.Culture)
            }
            else if (this._statisticsLoadedAtUtc is { } loadedAt)
            {
                @string.Format(Resources.ResourceManager.GetString("DashboardSnapshotAt", Resources.Culture) ?? string.Empty, loadedAt.ToString("yyyy-MM-dd HH:mm:ss"))
            }
            else
            {
                @Resources.ResourceManager.GetString("DashboardSnapshotLoading", Resources.Culture)
            }
        </span>
        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="this.RefreshStatisticsAsync" disabled="@this._isLoadingStatistics">@Resources.Refresh</button>
    </div>

    <section class="card dashboard-servers">
        <div class="card-header dashboard-section-header">
            <h2 class="h6 mb-0">@Resources.Servers</h2>
            <a href="servers">@Resources.DashboardManageServers</a>
        </div>
        <div class="dashboard-table-wrap">
            <table class="table dashboard-server-table mb-0">
                <thead>
                    <tr>
                        <th scope="col">@Resources.Name</th>
                        <th scope="col">@Resources.ResourceManager.GetString("DashboardServiceType", Resources.Culture)</th>
                        <th scope="col">@Resources.ResourceManager.GetString("DashboardServiceLoad", Resources.Culture)</th>
                        <th scope="col">@Resources.ResourceManager.GetString("DashboardServiceState", Resources.Culture)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var server in this._servers.OrderBy(s => s.Type).ThenBy(s => s.Description))
                    {
                        <tr>
                            <td class="server-name">@server.Description</td>
                            <td class="server-type">@server.Type.GetEnumCaption()</td>
                            <td class="server-load">@GetLoadText(server)</td>
                            <td>
                                <span class="server-state @GetServerStateClass(server.ServerState)">
                                    <span class="server-state__dot" aria-hidden="true"></span>
                                    @server.ServerState.GetEnumCaption()
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <div class="dashboard-grid dashboard-main">
        <OnlinePlayersChart />
        <AuthorizeView Policy="@AdminPolicies.Administrator">
            <div class="dashboard-side">
                <SystemInfoCard />
                <CastleSiegeCard />
                <ConfigurationUpdatesCard />
            </div>
        </AuthorizeView>
    </div>

    <div class="dashboard-grid dashboard-actions">
        @if (this._isGlobalMessageAvailable)
        {
            <section class="card">
                <div class="card-header"><h2 class="h6 mb-0">@Resources.GlobalMessage</h2></div>
                <div class="card-body">
                    <p class="dashboard-action-description">@Resources.ResourceManager.GetString("DashboardBroadcastDescription", Resources.Culture)</p>
                    <GlobalMessageForm Servers="@this._servers" Compact="true" />
                </div>
            </section>
        }
        <section class="card">
            <div class="card-header"><h2 class="h6 mb-0">@Resources.DashboardQuickActions</h2></div>
            <div class="card-body quick-actions">
                <a class="quick-action" href="accounts"><span class="oi oi-list" aria-hidden="true"></span> @Resources.Accounts</a>
                <a class="quick-action" href="logged-in"><span class="oi oi-people" aria-hidden="true"></span> @Resources.OnlineAccounts</a>
                @if (this._isBotFeatureAvailable)
                {
                    <a class="quick-action" href="logged-in?tab=bots"><span class="oi oi-person" aria-hidden="true"></span> @Resources.BotPlayers</a>
                }
                <a class="quick-action" href="guilds"><span class="oi oi-flag" aria-hidden="true"></span> @Resources.Guilds</a>
                @if (AdminPanelEnvironment.IsHostingEmbedded)
                {
                    <a class="quick-action" href="logfiles"><span class="oi oi-file" aria-hidden="true"></span> @Resources.LogFiles</a>
                }
                @if (AdminPanelEnvironment.IsGrafanaAvailable)
                {
                    <a class="quick-action" href="/grafana/dashboards" target="_blank"><span class="oi oi-bar-chart" aria-hidden="true"></span> @Resources.Metrics</a>
                }
            </div>
        </section>
    </div>
</div>
