@page "/api-keys"

@using MUnique.OpenMU.Web.AdminPanel.Properties
@attribute [Authorize(Policy = AdminPolicies.Administrator)]

@{
    var title = Resources.ApiKeys;
}
<PageTitle>OpenMU: @title</PageTitle>
<Breadcrumb IsFirstFromRoot="true" Caption="@title" />
<h3 class="admin-page-heading">@title</h3>

<p class="admin-page-description">@Resources.ApiKeysDescription</p>

@if (this._createdKey is { Length: > 0 } createdKey)
{
    <div class="alert alert-warning" role="alert">
        <h5 class="alert-heading">
            <span class="oi oi-key" aria-hidden="true"></span> @Resources.ApiKeyShownOnce
        </h5>
        <p>@Resources.ApiKeyShownOnceDescription</p>
        <div class="input-group">
            <input type="text" class="form-control font-monospace" readonly value="@createdKey" aria-label="@Resources.ApiKeys"/>
            <button type="button" class="btn btn-primary" @onclick="@this.CopyCreatedKeyAsync">
                <span class="oi oi-clipboard" aria-hidden="true"></span> @Resources.CopyToClipboard
            </button>
        </div>
        <button type="button" class="btn btn-sm btn-secondary mt-3" @onclick="@(() => this._createdKey = null)">@Resources.Close</button>
    </div>
}

@if (this._isLoading)
{
    <p>@Resources.Loading</p>
}
else
{
    @if (this._apiKeys.Any(this.IsCreatedBeforeFirstUser))
    {
        <div class="alert alert-warning" role="alert">
            <span class="oi oi-warning" aria-hidden="true"></span> @Resources.ApiKeysCreatedBeforeFirstUserHint
        </div>
    }

    <div class="admin-table-page">
        <div class="table-responsive">
        <table class="table table-sm">
            <thead>
            <tr>
                <th class="col-4">@Resources.ApiKeyName</th>
                <th class="col-2">@Resources.ApiKeyPrefix</th>
                <th class="col-2">@Resources.Role</th>
                <th>@MUnique.OpenMU.Web.AdminPanel.Services.ApiKeyToolGroupResources.Caption</th>
                <th class="col-4 text-end">@Resources.Actions</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var apiKey in this._apiKeys)
            {
                <tr class="@(apiKey.IsDisabled ? "opacity-50" : null)">
                    <td>
                        @apiKey.Name
                        @if (this.IsCreatedBeforeFirstUser(apiKey))
                        {
                            <span class="badge bg-warning text-dark ms-1">@Resources.ApiKeyCreatedBeforeFirstUser</span>
                        }
                    </td>
                    <td><code>@apiKey.KeyPrefix…</code></td>
                    <td>@MUnique.OpenMU.Web.AdminPanel.Auth.RoleCaption.Get(apiKey.Roles)</td>
                    <td>
                        <code>@apiKey.AllowedToolGroups</code>
                        <button type="button" class="btn admin-table-action admin-table-action--neutral" @onclick="@(() => this.OnEditToolGroupsAsync(apiKey))">@MUnique.OpenMU.Web.Shared.Properties.Resources.Change</button>
                    </td>
                    <td>
                        <div class="admin-table-actions">
                            @if (apiKey.IsDisabled)
                            {
                                <button type="button" class="btn admin-table-action admin-table-action--success" @onclick="@(() => this.OnSetDisabledAsync(apiKey, false))">@Resources.Enable</button>
                            }
                            else
                            {
                                <button type="button" class="btn admin-table-action admin-table-action--warning" @onclick="@(() => this.OnSetDisabledAsync(apiKey, true))">@Resources.Disable</button>
                            }
                            <button type="button" class="btn admin-table-action admin-table-action--danger" @onclick="@(() => this.OnDeleteAsync(apiKey))">@Resources.Delete</button>
                        </div>
                    </td>
                </tr>
            }
            @if (this._apiKeys.Count == 0)
            {
                <tr>
                    <td colspan="5" class="text-muted">@Resources.NoApiKeys</td>
                </tr>
            }
            </tbody>
        </table>
        </div>
        <div class="admin-table-footer">
            <button type="button" class="btn btn-success" @onclick="@this.OnCreateNewAsync">@Resources.CreateApiKey</button>
        </div>
    </div>
}
